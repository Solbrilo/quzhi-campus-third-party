[Unit]
Description=HotWater anonymous daily activity collector
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=hotwater-activity
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 /opt/hotwater-activity/activity_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
