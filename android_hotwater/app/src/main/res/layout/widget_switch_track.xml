<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_switch_track" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_switch_track_open" android:clipChildren="true" android:layoutDirection="ltr">
