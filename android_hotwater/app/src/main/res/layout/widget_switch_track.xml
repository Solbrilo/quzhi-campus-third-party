            <ImageView android:id="@+id/widget_led_off_0" android:layout_width="12dp" android:layout_height="12dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" android:src="@drawable/widget_led_idle" android:contentDescription="@null" />
        </RelativeLayout>
    </FrameLayout><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"><FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:padding="4dp">
