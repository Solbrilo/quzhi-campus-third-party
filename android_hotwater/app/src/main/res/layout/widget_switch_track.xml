        </RelativeLayout>
    </FrameLayout><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" /></LinearLayout>
    </ViewFlipper>
    <ViewFlipper android:id="@+id/widget_thumb_on" android:layout_width="match_parent" android:layout_height="match_parent" android:inAnimation="@anim/widget_thumb_on" android:animateFirstView="false" android:autoStart="false" android:visibility="invisible">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" /><FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:padding="4dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_switch_thumb" android:elevation="2dp" android:paddingStart="14dp" android:paddingEnd="14dp">
            <TextView android:id="@+id/widget_thumb_text_on_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:text="ON" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
            <ImageView android:id="@+id/widget_led_on_0" android:layout_width="12dp" android:layout_height="12dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" android:src="@drawable/widget_led_idle" android:contentDescription="@null" />
        </RelativeLayout>
    </FrameLayout></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" /><FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:padding="4dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_switch_thumb" android:elevation="2dp" android:paddingStart="14dp" android:paddingEnd="14dp">
